# Copy this file to .env for local development (the dev server and BFF read .env; the browser build reads .env.local for VITE_ vars).
#
# Server-side (the BFF under api/ — `vercel dev` reads .env.local too):
#   ZOHO_CLIENT_ID / ZOHO_CLIENT_SECRET / ZOHO_REFRESH_TOKEN / ZOHO_BASE_ID
#   ZOHO_DC (default tables.zoho.in), ALLOW_DEV_SESSION=1 for the dev fallback session
#   ALLOW_DEV_HOSTS=         # optional csv of extra hosts the dev session may serve (loopback
#                            # is always allowed) — a plant domain never mints a dev admin
#
# WorkOS AuthKit (the session cookie lives server-side; all three present = configured,
# and ALLOW_DEV_SESSION is ignored while they are):
#   WORKOS_CLIENT_ID / WORKOS_API_KEY (M2M sk_ key) / WORKOS_COOKIE_PASSWORD (32+ chars)
#   WORKOS_ORG_ID            # the one "Roligt Foods" organization, printed by scripts/workos/seed-rbac.mjs
#   WORKOS_REDIRECT_URI=     # optional: pin to e.g. https://<production-domain>/api/auth/callback
#                            # (unset defaults to localhost http; an https request still seals its
#                            # cookie Secure either way — the request's own protocol decides)
#   WORKOS_API_HOSTNAME=     # optional override; defaults to api.eu.workos.com
#   WORKOS_COOKIE_NAME=      # optional override; defaults to wos-session
# These are secrets — they stay server-side and must never gain a VITE_ prefix.
#
# Browser-side (a flag only — the SPA never talks to WorkOS; absent means the dev session):
# VITE_WORKOS_CLIENT_ID=
#
# Zoho Apptics client-side analytics — dev/staging trial. Present = the SDK script is
# emitted and boots (crash capture, screens, events); absent = the build carries nothing.
# NEVER set these in the Vercel Production environment.
# VITE_APPTICS_APP_TOKEN=          # the aaID inside the Apptics console's snippet
# VITE_APPTICS_DC=                 # optional data-center code the snippet shows (IN, EU…)
