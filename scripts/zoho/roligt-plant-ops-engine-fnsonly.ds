	 functions
	 {
		 Deluge
		 {
// ===========================================================================
// Roligt Plant Ops -- Deluge posting engine, v3
//
// Aligned to the IMPORTED app's actual field link names (roligt-plant-ops):
//   Counters: Series, Prefix, Pattern, Pad, Next
//   Ledger:   Doc, Type_field(text), Item(lookup->Items), Lot, Location(lookup->Storage_Locations),
//             Status(text), Qty_In, Qty_Out, Unit_Cost, Expiry(date), Time(datetime), Data_JSON
//   Audit_Log: Doc, Action_field, Details, Actor(text), Time(datetime)
//   GRNs: Doc_No, Date_field, Product(->Purchase_Products), UOM, Location(->Storage_Locations),
//         Vendor(->Vendors), Area, Harvested_On, Total, Accepted, Free, Grade_A/B/C, Reject,
//         Rate, Other_Charges, Status(Draft/Posted), Notes
//   Batches: Batch_No, Date_field, Kind(Extraction/Melange), Location(->Storage_Locations),
//            Spoiled, Cost_per_Unit, Status(Awaiting QC/Released/On Hold/Rejected), Data_JSON
//   QC_Records: Doc_No, Batch(lookup->Batches), Item(lookup->Items),
//            Disposition(Awaiting/Released/On Hold/Rejected), Tests_JSON, Attachments
//
// DELIVERY: embedded into the app .ds by scripts/zoho/embed-engine.mjs
//   (functions block + workflow block -- harvested dialect, Creator-written shapes).
//   PASTE remains the fallback: one function per block into Automation -> Functions.
//
// TWO-STAGE WIRING (the workflow block below emits exactly this):
//   on validate -> postGrnCheck / postBatchCheck   pure checks, cancel submit on error
//   on success  -> postGrn / postBatch             posting; the record now exists, so
//                  input.ID resolves the QC_Records.Batch lookup
// A posting failure at on-success cannot cancel the submit (checks already passed),
// so the record lands un-posted and the operator is told to fix and resubmit.
//
// Batches.Data_JSON contract (written into the Data JSON field, read by the engine):
//   {"sources":[{"item":"Tender Coconut","lot":"LOT-...","qty":500}],
//    "blends" :[{"item":"Coconut Water (bulk)","lot":"BAT-...","qty":180}],
//    "outputs":[{"item":"Coconut Water (bulk)","qty":180,"main":true},
//               {"item":"Malai (bulk)","qty":12,"main":false}]}
//   (item = Items.Name; lot = the producing document's number)
// ===========================================================================

// -- mintDocNo ----------------------------------------------------------------
string mintDocNo(string seriesKey)
{
    for attempt = 0; attempt < 5; attempt = attempt + 1)
    {
        cRec = Counters[Series == seriesKey];
        if(cRec.count() == 0) { return "-NO-SERIES-"; }
        n = cRec.Next.toLong();
        now = zoho.currentdate;
        code = cRec.Pattern;
        code = code.replaceAll("{P}", cRec.Prefix);
        code = code.replaceAll("{YYYY}", now.toString("yyyy"));
        code = code.replaceAll("{YYYYMMDD}", now.toString("yyyyMMdd"));
        padded = n.toString();
        padN = cRec.Pad == null ? 0 : cRec.Pad.toLong();
        for i = padded.length(); i < padN; i = i + 1)
        {
            padded = "0" + padded;
        }
        code = code.replaceAll("{N}", padded);
        // Advance only if the row still holds the number we read -- a concurrent
        // mint moves it first and this call retries instead of duplicating.
        upd = update Counters[Series == seriesKey && Next == n] set Next = (n + 1);
        if(upd.code == 3000) { return code; }
    }
    return "-MINT-RETRY-EXHAUSTED-";
}

// -- itemRef / locRef ---------------------------------------------------------
// Ledger.Item and Ledger.Location are lookups: they need record IDs. The engine
// speaks names everywhere (operators do); these resolve at the boundary.

string itemRef(string nameOrId)
{
    r = Items[ID == nameOrId];
    if(r.count() > 0) { return nameOrId; }
    r = Items[Name == nameOrId];
    if(r.count() > 0) { return r.ID; }
    return "";
}

string locRef(string nameOrId)
{
    r = Storage_Locations[ID == nameOrId];
    if(r.count() > 0) { return nameOrId; }
    r = Storage_Locations[Name == nameOrId];
    if(r.count() > 0) { return r.ID; }
    return "";
}

// -- ledgerBalance ------------------------------------------------------------
// What is on hand of one item's lot, optionally restricted to statuses -- the
// counterpart of onHand() in lib/posting.ts. Balance = sum(in) - sum(out) over
// the whole ledger; nothing is ever edited, so the sum is always the truth.

decimal ledgerBalance(string item, string lot, list statuses)
{
    iid = itemRef(item);
    rows = Ledger[Item == iid && Lot == lot];
    bal = 0.0;
    for r in rows
    {
        if(statuses.size() > 0 && !statuses.contains(r.Status)) { continue; }
        bal = bal + (r.Qty_In == null ? 0 : r.Qty_In.toDecimal()) - (r.Qty_Out == null ? 0 : r.Qty_Out.toDecimal());
    }
    return bal;
}

// -- drawStock ----------------------------------------------------------------
// The one consume pattern, ported from lib/posting.ts. Takes `qty` of one
// item's lot from wherever it sits (FIFO by ledger Time) among `statuses`,
// writing one OUT line per stock bucket drawn and returning {cost, unitCost}.
// Buckets key on location.status.expiry.unitCost, which preserves the React
// app's per-row costing without needing row identity.

map drawStock(string doc, string type, string item, string lot, decimal qty, list statuses)
{
    iid = itemRef(item);
    rows = Ledger[Item == iid && Lot == lot];
    // FIFO: earliest in, first out.
    sorted = rows.sort("Time", true);
    remaining = qty;
    cost = 0.0;
    for r in sorted
    {
        if(remaining <= 0.0001) { break; }
        if(statuses.size() > 0 && !statuses.contains(r.Status)) { continue; }
        bal = (r.Qty_In == null ? 0 : r.Qty_In.toDecimal()) - (r.Qty_Out == null ? 0 : r.Qty_Out.toDecimal());
        if(bal <= 0.0001) { continue; }
        use = remaining < bal ? remaining : bal;
        uc = r.Unit_Cost == null ? 0 : r.Unit_Cost.toDecimal();
        appendLedger({"doc": doc, "type": type, "item": iid, "lot": lot,
                      "location": r.Location, "status": r.Status,
                      "qtyIn": 0, "qtyOut": use, "unitCost": uc,
                      "expiry": r.Expiry, "time": zoho.currenttime});
        cost = cost + (use * uc);
        remaining = remaining - use;
    }
    return {"cost": cost, "unitCost": qty > 0 ? cost / qty : 0};
}

// -- appendLedger -------------------------------------------------------------
// The only way anything ever touches the Ledger. Append-only by convention: no
// function anywhere updates or deletes a Ledger row; a reversal is a new row.

map appendLedger(map line)
{
    lResp = insert into Ledger
        Doc        : line.get("doc")
        Type_field : line.get("type")
        Item       : line.get("item")
        Lot        : line.get("lot")
        Location   : line.get("location")
        Status     : line.get("status")
        Qty_In     : line.get("qtyIn")
        Qty_Out    : line.get("qtyOut")
        Unit_Cost  : line.get("unitCost")
        Expiry     : line.get("expiry")
        Time       : line.get("time")
        Data_JSON  : line.get("data");
    return lResp;
}

// -- audit --------------------------------------------------------------------
void audit(string doc, string action, string details)
{
    insert into Audit_Log
        Doc          : doc
        Action_field : action
        Details      : details
        Actor        : zoho.loginuser
        Time         : zoho.currenttime;
}

// -- postGrnCheck -------------------------------------------------------------
// Stage 1 for the GRNs on-add workflow: pure checks, no writes. Returns "" when
// the submission may proceed.

string postGrnCheck(map form)
{
    accepted = form.get("Accepted") == null ? 0 : form.get("Accepted").toDecimal();
    if(accepted < 1) { return "Accepted quantity has to be more than zero."; }
    vendor = Vendors[ID == form.get("Vendor")];
    if(vendor.count() == 0) { return "Pick the farmer or vendor this load came from."; }
    loc = Storage_Locations[ID == form.get("Location")];
    if(loc.count() == 0) { return "Pick where this load is put away."; }
    pp = Purchase_Products[ID == form.get("Product")];
    if(pp.count() == 0) { return "Pick the product this load is."; }
    if(pp.Item == null || pp.Item == "") { return "This purchase product has no item behind it."; }
    return "";
}

// -- postGrn ------------------------------------------------------------------
// Stage 2: mint, ledger, audit. Assumes postGrnCheck passed. Costing identical
// to the reference app:
//   landed     = rate * accepted + otherCharges    (what the load cost)
//   usableCost = landed / accepted                 (rejects and free stock cost
//                                                 nothing per unit -- the whole
//                                                 load rides on the accepted qty)

map postGrn(map form)
{
    accepted = form.get("Accepted").toDecimal();
    pp = Purchase_Products[ID == form.get("Product")];
    loc = Storage_Locations[ID == form.get("Location")];
    iid = pp.Item;

    rate = form.get("Rate") == null ? 0 : form.get("Rate").toDecimal();
    otherCharges = form.get("Other_Charges") == null ? 0 : form.get("Other_Charges").toDecimal();
    landed = (rate * accepted) + otherCharges;
    usableCost = accepted > 0 ? landed / accepted : 0;

    grnNo = mintDocNo("grn");
    if(grnNo.startsWith("-")) { return {"error": "Could not mint a GRN number. Try again."}; }
    lotNo = mintDocNo("lot");

    // Raw produce is usable on arrival -- QC gates what production makes, not
    // what the grove sends. Status Released, no expiry (produce is consumed,
    // never shipped).
    appendLedger({"doc": grnNo, "type": "GRN", "item": iid, "lot": lotNo,
                  "location": form.get("Location"), "status": "Released",
                  "qtyIn": accepted, "qtyOut": 0, "unitCost": usableCost,
                  "expiry": null, "time": zoho.currenttime});

    audit(grnNo, "Posted GRN", "Lot " + lotNo + " | " + accepted.toString() + " into " + loc.Label);
    return {"grn": grnNo, "lot": lotNo, "landed": landed, "usableCost": usableCost};
}

// -- postBatchCheck -----------------------------------------------------------
// Stage 1 for the Batches on-add workflow: pure checks, no writes. Ported from
// checkBatch (lib/posting.ts):
//   - every line's item must resolve; outputs unique with qty > 0
//   - exactly one output marked main (the one the whole input cost sits on)
//   - stock sufficiency summed per item+lot across duplicate lines -- line-by-line
//     checks pass twice on one balance and draw more than the lot holds
//   - raw produce issues from Available; bulk blends from anything drawable
//     (Available/Quarantine/Released) -- QC-rejected bulk reaches no bottle and
//     no blend

string postBatchCheck(map form)
{
    kind = form.get("Kind");
    blending = kind == "Melange";
    if(form.get("Location") == null || form.get("Location") == "") { return "Pick where the batch output is put away."; }
    if(form.get("Data_JSON") == null || form.get("Data_JSON") == "") { return "Batch payload (Data JSON) is missing."; }
    payload = form.get("Data_JSON").toMap();
    rawS = payload.get("sources");
    sources = rawS == null ? list() : rawS.toList();
    rawB = payload.get("blends");
    blends = rawB == null ? list() : rawB.toList();
    rawO = payload.get("outputs");
    outputs = rawO == null ? list() : rawO.toList();
    if(blending && blends.size() == 0) { return "Add at least one bulk component to blend."; }
    if(!blending && sources.size() == 0) { return "Add at least one source lot."; }
    if(outputs.size() == 0) { return "Record what came out of the batch."; }

    // Outputs: unique items, exactly one main, items resolvable.
    mains = 0;
    outItems = list();
    for o in outputs
    {
        om = o.toMap();
        oq = om.get("qty") == null ? 0 : om.get("qty").toDecimal();
        if(oq <= 0) { continue; }
        if(outItems.contains(om.get("item"))) { return "Each output can only be listed once."; }
        if(itemRef(om.get("item")) == "") { return "Unknown output item: " + om.get("item"); }
        outItems.add(om.get("item"));
        if(om.get("main") == true) { mains = mains + 1; }
    }
    if(mains != 1) { return "Mark exactly one output as the one the batch cost sits on."; }

    srcStat = {"Available"};
    drawStat = {"Available", "Quarantine", "Released"};

    wanted = map();
    for l in sources
    {
        lm = l.toMap();
        k = lm.get("item") + "|" + lm.get("lot");
        q = lm.get("qty") == null ? 0 : lm.get("qty").toDecimal();
        wanted.put(k, (wanted.get(k) == null ? 0 : wanted.get(k).toDecimal()) + q);
    }
    for k in wanted.keys()
    {
        parts = k.split("|");
        if(itemRef(parts.get(0)) == "") { return "Unknown source item: " + parts.get(0); }
        if(wanted.get(k).toDecimal() > ledgerBalance(parts.get(0), parts.get(1), srcStat) + 0.0001)
        {
            return parts.get(1) + " does not have that much " + parts.get(0) + " left.";
        }
    }

    if(blending)
    {
        wantedB = map();
        for l in blends
        {
            lm = l.toMap();
            k = lm.get("item") + "|" + lm.get("lot");
            q = lm.get("qty") == null ? 0 : lm.get("qty").toDecimal();
            wantedB.put(k, (wantedB.get(k) == null ? 0 : wantedB.get(k).toDecimal()) + q);
        }
        for k in wantedB.keys()
        {
            parts = k.split("|");
            if(itemRef(parts.get(0)) == "") { return "Unknown component item: " + parts.get(0); }
            if(wantedB.get(k).toDecimal() > ledgerBalance(parts.get(0), parts.get(1), drawStat) + 0.0001)
            {
                return parts.get(1) + " does not have that much " + parts.get(0) + " left.";
            }
        }
        // A component cannot be its own blend.
        for l in blends
        {
            if(outItems.contains(l.toMap().get("item")))
            {
                return l.toMap().get("item") + " cannot be both a component and the blend it makes.";
            }
        }
    }

    issued = 0.0;
    for l in sources
    {
        lm = l.toMap();
        q = lm.get("qty") == null ? 0 : lm.get("qty").toDecimal();
        issued = issued + q;
    }
    if(!blending && form.get("Spoiled") != null && form.get("Spoiled").toDecimal() >= issued && issued > 0)
    {
        return "Spoiled quantity must be less than the quantity issued.";
    }
    return "";
}

// -- postBatch ----------------------------------------------------------------
// Stage 2: draw, outputs, QC records, audit. Assumes postBatchCheck passed.
// batchRecId is input.ID from the on-success workflow -- the Batches record
// exists by then, which is what lets the QC_Records.Batch lookup resolve.
//   - every line drawn at the cost it carries (FIFO) -- never at a typed price
//   - outputs enter stock as Quarantine ("Awaiting QC"), one QC record each:
//     a pressing gives water and malai and they are tested apart -- the water
//     can release while the malai is still on the bench
//   - the WHOLE input cost lands on the one output marked main; a by-product
//     carries zero, so the main's cost-per-litre never moves with by-yield

map postBatch(map form, string batchRecId)
{
    kind = form.get("Kind");
    blending = kind == "Melange";
    payload = form.get("Data_JSON").toMap();
    rawS = payload.get("sources");
    sources = rawS == null ? list() : rawS.toList();
    rawB = payload.get("blends");
    blends = rawB == null ? list() : rawB.toList();
    rawO = payload.get("outputs");
    outputs = rawO == null ? list() : rawO.toList();
    srcStat = {"Available"};
    drawStat = {"Available", "Quarantine", "Released"};

    batchNo = mintDocNo(blending ? "melangeBatch" : "batch");
    if(batchNo.startsWith("-")) { return {"error": "Could not mint a batch number. Try again."}; }

    // Draw everything issued; cost accumulates from the rows actually taken.
    inputCost = 0.0;
    for l in sources
    {
        lm = l.toMap();
        q = lm.get("qty") == null ? 0 : lm.get("qty").toDecimal();
        d = drawStock(batchNo, "Production Consume", lm.get("item"), lm.get("lot"), q, srcStat);
        inputCost = inputCost + d.get("cost").toDecimal();
    }
    for l in blends
    {
        lm = l.toMap();
        q = lm.get("qty") == null ? 0 : lm.get("qty").toDecimal();
        d = drawStock(batchNo, "Melange Consume", lm.get("item"), lm.get("lot"), q, drawStat);
        inputCost = inputCost + d.get("cost").toDecimal();
    }

    // Outputs into the bulk cold room as Quarantine, cost on the main line only.
    mainQty = 0.0;
    for o in outputs
    {
        om = o.toMap();
        qty = om.get("qty") == null ? 0 : om.get("qty").toDecimal();
        if(qty <= 0) { continue; }
        isMain = om.get("main") == true;
        uc = isMain && qty > 0 ? inputCost / qty : 0;
        appendLedger({"doc": batchNo, "type": blending ? "Melange Output" : "Production Output",
                      "item": itemRef(om.get("item")), "lot": batchNo,
                      "location": form.get("Location"), "status": "Quarantine",
                      "qtyIn": qty, "qtyOut": 0, "unitCost": uc,
                      "expiry": null, "time": zoho.currenttime});
        qcNo = mintDocNo("qc");
        insert into QC_Records
            Doc_No      : qcNo
            Batch       : batchRecId
            Item        : itemRef(om.get("item"))
            Disposition : "Awaiting"
            Tests_JSON  : "{}";
        audit(qcNo, "Raised QC record", om.get("item") + " from " + batchNo + ".");
        if(isMain) { mainQty = qty; }
    }

    audit(batchNo, blending ? "Posted melange" : "Posted production", batchNo + " | cost " + inputCost.toString());
    return {"batch": batchNo, "inputCost": inputCost, "mainQty": mainQty,
            "costPerUnit": mainQty > 0 ? inputCost / mainQty : 0};
}

// === NEXT PORTS (same skeleton -- check/post split, draw via drawStock,
// refuse loudly, audit) ===
//  releaseQc   -- QC record's tests decide disposition; releasing writes paired
//                ledger lines moving the batch output Quarantine->Released (OUT
//                from old status + IN to Released, never an edit). Wire as an
//                on-edit workflow on QC_Records (Disposition change). Port from
//                src/context/domains/quality.ts + storage.ts (status transfer).
//  postPacking -- draws bulk FIFO + BOM packing material, books packs with
//                expiry = pack date + product.Shelf_Life_Days; pack status
//                inherits the BULK's QC verdict, not the batch's. Port from
//                lib/posting.ts checkPacking/postPackingLines (control samples
//                v1 can defer; note it).
//  postDispatch-- one stock row (item.lot.location.expiry) must be Released and
//                outside a hold area; complete-order rule lives in the order
//                flow. Port from checkDispatch/checkOrderDispatch.
//  postIssue   -- writes stock off with a reason; any status may go. Port from
//                src/context/domains/inventory.ts.
// ===========================================================================
		 }
	 }


