    			type = text
	 			row = 3
	 			column = 1
				width = medium
			)
			Area
			(
    			type = text
	 			row = 4
	 			column = 1
				width = medium
			)
			Payment_Terms
			(
    			type = text
    			displayname = "Payment Terms"
	 			row = 5
	 			column = 1
				width = medium
			)
			must have Status
			(
    			type = picklist
    			maxchar = 100
    			values = {"Active","Inactive"}
	 			row = 6
	 			column = 1
				width = medium
			)
			Email
			(
    			type = email
    			maxchar = 80
	 			row = 7
	 			column = 1
				width = medium
			)
			Notes
			(
    			type = textarea
    			height = 100px
	 			row = 8
	 			column = 1
				width = medium
			)
			actions
			{
				on add
				{
