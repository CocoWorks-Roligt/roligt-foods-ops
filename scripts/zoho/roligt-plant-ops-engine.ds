// NEXT PORTS (same skeleton -- check/post split, draw via drawStock,
// refuse loudly, audit): releaseQc (on-edit of QC_Records), postPacking,
// postDispatch, postIssue. Sources: src/context/domains/quality.ts,
// packing (lib/posting.ts checkPacking/postPackingLines), sales.ts, inventory.ts.
// ============================================================================
		 }
	 }


	workflow
	{
	form
	{
		grn_check as "GRN check"
		{
			type = form
			form = GRNs

			record event = on add

			on validate
			{
				actions
				{
					custom deluge script
					(
						e = postGrnCheck(input.toMap());
						if(e != "")
						{
						alert e;
						cancel submit;
						}
					)
				}
			}
		}
		grn_post as "GRN post"
		{
			type = form
			form = GRNs

			record event = on add

			on success
			{
				actions
				{
					custom deluge script
					(
						r = postGrn(input.toMap());
						if(r.get("error") == null)
						{
						input.Doc_No = r.get("grn");
						input.Status = "Posted";
						notesPrefix = "";
						if(!isNull(input.Notes))
						{
						notesPrefix = input.Notes;
						}
						input.Notes = notesPrefix + " | Lot " + r.get("lot");
						}
						else
						{
						alert "Posting failed - this record is saved WITHOUT stock lines. Fix and resubmit: " + r.get("error");
						}
					)
				}
			}
		}
		batch_check as "Batch check"
		{
			type = form
			form = Batches

			record event = on add

			on validate
			{
				actions
				{
					custom deluge script
					(
						e = postBatchCheck(input.toMap());
						if(e != "")
						{
						alert e;
						cancel submit;
						}
					)
				}
			}
		}
		batch_post as "Batch post"
		{
			type = form
			form = Batches

			record event = on add

			on success
			{
				actions
				{
					custom deluge script
					(
						r = postBatch(input.toMap(), input.ID);
						if(r.get("error") == null)
						{
						input.Batch_No = r.get("batch");
						input.Cost_per_Unit = r.get("costPerUnit");
						input.Status = "Awaiting QC";
						}
						else
						{
						alert "Posting failed - this record is saved WITHOUT stock lines. Fix and resubmit: " + r.get("error");
						}
					)
				}
			}
		}
	}
	}

