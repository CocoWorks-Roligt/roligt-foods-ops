			(
				type = section
	 			row = 1
	 			column = 0
				width = medium
			)
			must have Plan_No
			(
    			type = text
    			displayname = "Plan No"
	 			row = 1
	 			column = 1
				width = medium
			)
			Day
			(
    			type = date
    			alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1
				width = medium
			)
			must have Stage
			(
    			type = picklist
    			maxchar = 100
    			values = {"Extraction","Melange","Packing"}
