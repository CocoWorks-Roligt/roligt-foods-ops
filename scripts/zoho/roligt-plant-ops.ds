 application "Roligt Plant Ops"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Vendor_Types
		{
			displayname = "Vendor Types"
			success message = "Vendor Types Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0
				width = medium
			)
			must have Name
			(
    			type = text
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Source_Kind
			(
    			type = picklist
    			maxchar = 100
    			displayname = "Source Kind"
    			values = {"Farmer","Vendor","Other"}
	 			row = 2
	 			column = 1
				width = medium
			)
			Description
			(
    			type = textarea
    			displayname = "Description"
    			height = 100px
	 			row = 3
	 			column = 1
				width = medium
			)
			must have Status
			(
    			type = picklist
    			maxchar = 100
    			values = {"Active","Inactive"}
	 			row = 4
	 			column = 1
				width = medium
			)
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}
		form Vendors
		{
			displayname = "Vendors"
			success message = "Vendors Added Successfully"
