				description = "This profile will have all the permissions.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

	web
	{
		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Masters
				{
					displayname = "Masters"
					icon = "design-app"
					form  Vendor_Types { icon = "tech-2-keyboard-wireless" }
					report All_Vendor_Types { icon = "tech-desktop" }
					form  Vendors { icon = "business-badge-3" }
					report All_Vendors { icon = "tech-desktop" }
					form  Customers { icon = "users-multiple-11" }
					report All_Customers { icon = "tech-desktop" }
					form  Items { icon = "shopping-box" }
					report All_Items { icon = "tech-desktop" }
					form  Purchase_Products { icon = "shopping-cart-simple" }
					report All_Purchase_Products { icon = "tech-desktop" }
